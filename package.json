{
  "name": "live-resume",
  "version": "1.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:en": "ng serve --configuration en",
    "start:pt": "ng serve --configuration pt",
    "build": "ng build",
    "build:en": "ng build --configuration en",
    "build:pt": "ng build --configuration pt",
    "test": "ng test",
    "lint": "ng lint",
    "test:e2e": "npm run build-locale && playwright test",
    "test:e2e:run": "playwright test",
    "int:extract": "ng extract-i18n --output-path src/locales",
    "build-locale:en": "ng build --configuration en",
    "build-locale:pt": "ng build --configuration pt",
    "build-locale": "npm run build-locale:en && npm run build-locale:pt"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/animations": "20.3.33",
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/forms": "20.3.33",
    "@angular/localize": "20.3.33",
    "@angular/platform-browser": "20.3.33",
    "@angular/platform-browser-dynamic": "20.3.33",
    "@angular/router": "20.3.33",
    "@fortawesome/angular-fontawesome": "2.0.1",
    "@fortawesome/free-brands-svg-icons": "5.15.4",
    "@fortawesome/free-solid-svg-icons": "5.15.4",
    "firebase": "11.10.0",
    "hammerjs": "2.0.8",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.37",
    "@angular-eslint/builder": "19.8.1",
    "@angular-eslint/eslint-plugin": "19.8.1",
    "@angular-eslint/eslint-plugin-template": "19.8.1",
    "@angular-eslint/schematics": "19.8.1",
    "@angular-eslint/template-parser": "19.8.1",
    "@angular/cli": "20.3.37",
    "@angular/compiler-cli": "20.3.33",
    "@angular/language-service": "20.3.33",
    "@playwright/test": "1.63.0",
    "@types/jasmine": "4.3.6",
    "@types/node": "24.19.1",
    "@typescript-eslint/parser": "8.71.0",
    "@typescript-eslint/utils": "8.71.0",
    "eslint": "8.57.1",
    "jasmine-core": "4.6.1",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage-istanbul-reporter": "2.1.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "5.8.3"
  }
}
