{
  "name": "live-resume",
  "version": "1.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:en": "ng serve --configuration en",
    "start:pt": "ng serve --configuration pt",
    "build": "ng build",
    "build:en": "ng build --configuration en",
    "build:pt": "ng build --configuration pt",
    "test": "ng test",
    "lint": "ng lint",
    "test:e2e": "npm run build-locale && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:docker": "bash e2e/docker.sh",
    "int:extract": "ng extract-i18n --output-path src/locales",
    "build-locale:en": "ng build --configuration en",
    "build-locale:pt": "ng build --configuration pt",
    "build-locale": "npm run build-locale:en && npm run build-locale:pt"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/localize": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "@fortawesome/angular-fontawesome": "4.0.0",
    "@fortawesome/free-brands-svg-icons": "5.15.4",
    "@fortawesome/free-solid-svg-icons": "5.15.4",
    "firebase": "11.10.0",
    "hammerjs": "2.0.8",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.24",
    "@angular-eslint/builder": "21.4.0",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "@angular/language-service": "21.2.25",
    "@playwright/test": "1.63.0",
    "@types/jasmine": "4.3.6",
    "@types/node": "24.19.1",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.5",
    "jasmine-core": "4.6.1",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage-istanbul-reporter": "2.1.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
