{
  "functions": [
    {
      "source": "functions",
      "codebase": "assistant",
      "runtime": "nodejs24",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": ["node_modules", "src", "test", "*.log", "tsconfig.json", "vitest.config.ts", "build.mjs"]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "functions": { "port": 5001 },
    "firestore": { "port": 8085 },
    "ui": { "enabled": true, "port": 4400 }
  }
}
